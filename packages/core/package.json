{
  "name": "@kopru/core",
  "version": "0.0.0",
  "description": "Köprü çekirdek paketi: ortak sözleşmeler, şemalar, hatalar ve yardımcılar.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevVettel/kopru.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist coverage .turbo"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@kopru/eslint-config": "workspace:*",
    "@kopru/tsconfig": "workspace:*",
    "@kopru/tsup-config": "workspace:*",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
