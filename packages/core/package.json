{
  "name": "@kopru/core",
  "version": "0.0.0",
  "description": "Köprü çekirdek paketi: ortak sözleşmeler, şemalar, hatalar ve yardımcılar.",
  "keywords": [
    "kopru",
    "turkey",
    "payment",
    "cargo",
    "e-invoice",
    "iyzico",
    "virtual-pos",
    "zod",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevVettel/kopru.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/DevVettel/kopru/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/DevVettel/kopru/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist coverage .turbo"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "fast-xml-builder": "^1.3.2",
    "fast-xml-parser": "^5.12.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "vitest": "^5.1.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kopru/eslint-config": "workspace:*",
    "@kopru/tsconfig": "workspace:*",
    "@kopru/tsup-config": "workspace:*",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
