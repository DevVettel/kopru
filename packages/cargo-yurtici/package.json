{
  "name": "@kopru/yurtici",
  "version": "0.0.0",
  "description": "Köprü Yurtiçi Kargo sağlayıcısı: SOAP web servisi üzerinden gönderi oluşturma, iptal ve takip.",
  "keywords": [
    "kopru",
    "yurtici",
    "yurtici-kargo",
    "cargo",
    "shipping",
    "soap",
    "turkey"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevVettel/kopru.git",
    "directory": "packages/cargo-yurtici"
  },
  "homepage": "https://github.com/DevVettel/kopru/tree/main/packages/cargo-yurtici#readme",
  "bugs": {
    "url": "https://github.com/DevVettel/kopru/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist coverage .turbo"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@kopru/core": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@kopru/eslint-config": "workspace:*",
    "@kopru/mock-server": "workspace:*",
    "@kopru/tsconfig": "workspace:*",
    "@kopru/tsup-config": "workspace:*",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
