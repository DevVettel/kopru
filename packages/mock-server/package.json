{
  "name": "@kopru/mock-server",
  "version": "0.0.0",
  "description": "Köprü sağlayıcı taklit sunucusu: deterministik senaryolarla entegrasyon testleri için Hono tabanlı mock server.",
  "keywords": [
    "kopru",
    "mock-server",
    "testing",
    "payment",
    "cargo",
    "hono"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevVettel/kopru.git",
    "directory": "packages/mock-server"
  },
  "homepage": "https://github.com/DevVettel/kopru/tree/main/packages/mock-server#readme",
  "bugs": {
    "url": "https://github.com/DevVettel/kopru/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "kopru-mock": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist coverage .turbo"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "@kopru/core": "workspace:*",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@kopru/eslint-config": "workspace:*",
    "@kopru/tsconfig": "workspace:*",
    "@kopru/tsup-config": "workspace:*",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
